parameters:
	ignoreErrors:
		-
			message: '#^Method Omnihub\\Licensing\:\:toArray\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Licensing.php

		-
			message: '#^Method Omnihub\\SigningKey\:\:signToken\(\) has parameter \$payload with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/SigningKey.php

		-
			message: '#^Method Omnihub\\SigningKey\:\:verifyToken\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/SigningKey.php

		-
			message: '#^Binary operation "\." between mixed and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Cannot access offset ''licensing'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Method Omnihub\\Tests\\LicensingTest\:\:bin\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Method Omnihub\\Tests\\LicensingTest\:\:manifest\(\) has parameter \$settings with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Method Omnihub\\Tests\\LicensingTest\:\:manifest\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Method Omnihub\\Tests\\LicensingTest\:\:manifest\(\) should return array but returns mixed\.$#'
			identifier: return.type
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Offset 1 might not exist on array\{\}\|array\{non\-falsy\-string, non\-empty\-string, non\-empty\-string, non\-empty\-string\}\.$#'
			identifier: offsetAccess.notFound
			count: 2
			path: tests/LicensingTest.php

		-
			message: '#^Offset 1 might not exist on array\{\}\|array\{non\-falsy\-string, non\-empty\-string\}\.$#'
			identifier: offsetAccess.notFound
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Offset 2 might not exist on array\{\}\|array\{non\-falsy\-string, non\-empty\-string, non\-empty\-string, non\-empty\-string\}\.$#'
			identifier: offsetAccess.notFound
			count: 2
			path: tests/LicensingTest.php

		-
			message: '#^Offset 3 might not exist on array\{\}\|array\{non\-falsy\-string, non\-empty\-string, non\-empty\-string, non\-empty\-string\}\.$#'
			identifier: offsetAccess.notFound
			count: 3
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#1 \$process of function proc_close expects resource, resource\|false given\.$#'
			identifier: argument.type
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#1 \$signature of function sodium_crypto_sign_verify_detached expects non\-empty\-string, string given\.$#'
			identifier: argument.type
			count: 2
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#1 \$string of function trim expects string, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#2 \$haystack of static method PHPUnit\\Framework\\Assert\:\:assertStringContainsString\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 9
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#2 \$haystack of static method PHPUnit\\Framework\\Assert\:\:assertStringNotContainsString\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#2 \$string of static method PHPUnit\\Framework\\Assert\:\:assertMatchesRegularExpression\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 1
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#2 \$subject of function preg_match expects string, mixed given\.$#'
			identifier: argument.type
			count: 2
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#3 \$message of static method PHPUnit\\Framework\\Assert\:\:assertSame\(\) expects string, mixed given\.$#'
			identifier: argument.type
			count: 6
			path: tests/LicensingTest.php

		-
			message: '#^Parameter \#3 \$public_key of function sodium_crypto_sign_verify_detached expects non\-empty\-string, string given\.$#'
			identifier: argument.type
			count: 2
			path: tests/LicensingTest.php
