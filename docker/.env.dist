# The harness's settings: copy to .env (git-ignored), fill in what you have.

# Where the providers' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIHUB_PLUGINS=../..
# omnisense/contracts from its checkout beside the family's folder (GitHub's 1.x otherwise):
#OMNISENSE_CONTRACTS=../../../omnisense-contracts

# omnihub/github: a token lifts GitHub's limits for `build` (60 requests an hour without one).
# Only public repositories are read, whatever the token can see. `bare` and `test` need none.
GITHUB_TOKEN=
